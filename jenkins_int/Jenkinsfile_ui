pipeline {
    agent any

    parameters {
        string(name: 'BASIC_URL', defaultValue: 'https://qauto.forstudy.space', description: 'Base URL under test')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Hellrazers/Hillel_07_05.git'
            }
        }

        stage('Run Tests in Docker') {
            steps {
                sh '''
                    # Write .env file in the workspace
                    cat <<EOF > .env
BASIC_URL=${BASIC_URL}
USER_LOGIN=${USER_EMAIL_LOGIN:-guest}
USER_PASSWORD=${USER_PASSWORD_LOGIN:-default_pass}
BASIC_AUTH_USER=guest
BASIC_AUTH_PASS=welcome2qauto
EOF

                    # Run tests inside Playwright container mounting the workspace
                    docker run --rm \
                        -u 0:0 \
                        -v "${WORKSPACE}":/app \
                        -w /app \
                        mcr.microsoft.com/playwright/python:v1.61.0-noble \
                        bash -c "
                            pip install -r requirement.txt
                            playwright install firefox
                            pytest -m ui_test --alluredir=allure-results --browser=firefox
                        "
                '''
            }
        }
    }

    post {
        always {
            allure includeProperties: false, jdk: '', results: [[path: 'allure-results']]
        }
    }
}